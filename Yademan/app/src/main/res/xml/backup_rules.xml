<?xml version="1.0" encoding="utf-8"?>
<!-- مسیر: Yademan/app/src/main/res/xml/backup_rules.xml -->
<!-- بکاپ اندروید ۶ تا ۱۱: توکن رمزشده نباید بکاپ شود (کلید Keystore روی گوشی جدید وجود ندارد) -->
<full-backup-content>
    <exclude domain="sharedpref" path="yademan_auth.xml" />
    <exclude domain="sharedpref" path="yademan_auth_fallback.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>
