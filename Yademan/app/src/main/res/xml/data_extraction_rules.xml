<?xml version="1.0" encoding="utf-8"?>
<!-- مسیر: Yademan/app/src/main/res/xml/data_extraction_rules.xml -->
<!-- بکاپ اندروید ۱۲+: همان قانون backup_rules برای ابر و انتقال دستگاه -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="yademan_auth.xml" />
        <exclude domain="sharedpref" path="yademan_auth_fallback.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yademan_auth.xml" />
        <exclude domain="sharedpref" path="yademan_auth_fallback.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
