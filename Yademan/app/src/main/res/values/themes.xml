<?xml version="1.0" encoding="utf-8"?>
<!-- مسیر: Yademan/app/src/main/res/values/themes.xml -->
<resources>
    <!-- تم پنجره: پس‌زمینه تیره تا قبل از رندر Compose سفید فلش نزند -->
    <style name="Theme.Yademan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg0</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- اسپلش (androidx.core:core-splashscreen) -->
    <style name="Theme.Yademan.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Yademan</item>
    </style>
</resources>
